# Bu dosyayı ".env" adıyla kopyalayıp doldurun. ".env" Git'e gönderilmez.
# GitHub Actions'ta aynı adlarla "Secrets" olarak tanımlanır (python -m radar yayinla bunu yapar).
# Anahtarları sohbete, belgeye ya da başka bir dosyaya yazmayın.

# --- Fiyat kaynağı (Travelpayouts) ---
# Panel → profil → API token
TRAVELPAYOUTS_TOKEN=
# Ortaklık kimliği (marker)
TRAVELPAYOUTS_MARKER=

# --- Kasa (Cloudflare Worker) ---
# Kasa worker'ının adresi ve radarın /api/ic/* uçları için rastgele anahtar (en az 32 bayt)
KASA_URL=
RADAR_API_TOKEN=

# --- Telegram ---
# BotFather'dan alınan bot anahtarı
TELEGRAM_BOT_TOKEN=
# Bildirimlerin gideceği grup kimliği (grup kimlikleri - ile başlar)
TELEGRAM_CHAT_ID=
# Teknik uyarılar için ayrı grup
TELEGRAM_TECH_CHAT_ID=

# --- WhatsApp (isteğe bağlı) ---
# Meta WhatsApp Cloud API test numarası: ücretsiz, en fazla 5 doğrulanmış alıcı.
# Kalıcı "system user" erişim anahtarı (geçici anahtar 24 saatte biter)
WHATSAPP_TOKEN=
# API Setup sayfasındaki "Phone number ID" (telefon numarasının kendisi değil)
WHATSAPP_PHONE_NUMBER_ID=
# Alıcılar, ülke koduyla, virgülle
WHATSAPP_TO=
# Onaylı şablonun adı ve dili (gövdesinde tek değişken {{1}})
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=

# --- E-posta ---
# Gmail: smtp.gmail.com, 587, iki adımlı doğrulama + 16 haneli uygulama şifresi
SMTP_HOST=
SMTP_PORT=
# 465 portu kullanılıyorsa true yapın
SMTP_SSL=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Virgülle ayrılmış alıcılar
EMAIL_TO=

# --- İzleme (Grafana Cloud, Loki) ---
# Boş bırakılırsa izleme kapalıdır. Yalnızca logs:write yetkili, bu projeye özel anahtar.
LOKI_URL=
LOKI_USER=
LOKI_TOKEN=
